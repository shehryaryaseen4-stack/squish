PORT=3000
SITE_NAME=PDFKaro
# Public URL, used for canonical tags, the sitemap and share images. Set this in production.
BASE_URL=https://yourdomain.com
# Shown on /contact and /privacy
# CONTACT_EMAIL=hello@yourdomain.com
# Number of reverse proxies in front of the app (Nginx, Caddy, Cloudflare, Render...): usually 1
# TRUST_PROXY=1
# 301 every request to BASE_URL's exact protocol and host (only once DNS + HTTPS work)
# FORCE_CANONICAL_HOST=1

# --- Limits ---
# Largest upload for server-side tools (MB). Cloudflare's free plan stops at 100 MB.
MAX_UPLOAD_MB=100
# Browser-side tools: largest file accepted, to protect visitors' devices (MB)
MAX_BROWSER_MB=250
# Server-tool requests per IP per 15 minutes
RATE_LIMIT_MAX=60
# Jobs running at once / waiting in the queue / seconds before a job is stopped
MAX_JOBS=2
MAX_QUEUE=20
JOB_TIMEOUT_S=240
# Largest result sent back (MB) and most pages per PDF on server tools
MAX_OUTPUT_MB=400
MAX_PAGES=1000

# --- Engines ---
# Python with pdf2docx, pdfplumber and openpyxl (the Dockerfile uses a venv)
# PYTHON=/opt/py/bin/python
# How to start OCRmyPDF, if not simply "ocrmypdf"
# OCRMYPDF=ocrmypdf
# Switch tools off even if installed, by binary name (e.g. ocrmypdf,soffice,gs,qpdf,tesseract,pdfimages,python)
# PDFTOOLS_DISABLE=

# --- Google AdSense (leave empty until approved) ---
# ADSENSE_CLIENT=ca-pub-0000000000000000
# ADSENSE_SLOT_TOP=
# ADSENSE_SLOT_CONTENT=
# ADSENSE_SLOT_TOOL=
# ADSENSE_SLOT_FOOTER=
# Show outlined boxes where ads will go (layout work only)
# SHOW_AD_PLACEHOLDERS=1

# --- Search engines ---
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
