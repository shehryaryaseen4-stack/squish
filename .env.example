PORT=3000
MAX_FILE_MB=40
RATE_LIMIT_MAX=120
BASE_URL=https://yourdomain.com
SITE_NAME=Flipit Free
# TRUST_PROXY=1

# --- SEO (all optional) ---
# Redirect http->https and www/non-www to BASE_URL's exact origin (only enable once DNS + HTTPS work)
# FORCE_CANONICAL_HOST=1
# Shown on /contact, /privacy and in the Organization structured data
# CONTACT_EMAIL=hello@yourdomain.com
# Search engine ownership verification: paste only the content="..." value
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# YANDEX_VERIFICATION=
# PINTEREST_VERIFICATION=
# IndexNow key (8-128 letters/digits/dashes); served at /<key>.txt for Bing/Yandex
# INDEXNOW_KEY=
# Twitter/X handle for share cards, e.g. @flipitfree
# TWITTER_SITE=
# Sitemap lastmod override (YYYY-MM-DD); defaults to when content files last changed
# SITE_UPDATED=

# --- Conversion engines (all optional) ---
# Conversions that run at the same time; extra uploads wait in a queue
# MAX_JOBS=2
# Seconds before a single conversion is stopped
# JOB_TIMEOUT_S=180
# Largest converted file the server will send back (MB)
# MAX_OUTPUT_MB=500
# Largest total size an archive may unpack to (MB) - zip-bomb protection
# MAX_EXTRACT_MB=500
# Switch engines off even if installed, by binary name (e.g. heavy video work)
# SQUISH_DISABLE=ffmpeg,ebook-convert

# Google AdSense (leave empty until your account is approved). See README "AdSense".
# ADSENSE_CLIENT=ca-pub-0000000000000000
# Optional ad unit IDs; without them, use Auto ads in the AdSense dashboard.
# ADSENSE_SLOT_TOP=
# ADSENSE_SLOT_BOTTOM=
# ADSENSE_SLOT_LEFT=
# ADSENSE_SLOT_RIGHT=
