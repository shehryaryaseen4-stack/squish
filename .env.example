PORT=3000
MAX_FILE_MB=40
RATE_LIMIT_MAX=120
BASE_URL=https://yourdomain.com
SITE_NAME=Flipit Free
# TRUST_PROXY=1

# --- SEO (all optional) ---
# Redirect http->https and www/non-www to BASE_URL's exact origin (only enable once DNS + HTTPS work)
# FORCE_CANONICAL_HOST=1
# Shown on /contact, /privacy and in the Organization structured data
# CONTACT_EMAIL=hello@yourdomain.com
# Search engine ownership verification: paste only the content="..." value
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# YANDEX_VERIFICATION=
# PINTEREST_VERIFICATION=
# IndexNow key (8-128 letters/digits/dashes); served at /<key>.txt for Bing/Yandex
# INDEXNOW_KEY=
# Twitter/X handle for share cards, e.g. @flipitfree
# TWITTER_SITE=
# Sitemap lastmod override (YYYY-MM-DD); defaults to when content files last changed
# SITE_UPDATED=

# --- Conversion engines (all optional) ---
# Conversions that run at the same time; extra uploads wait in a queue
# MAX_JOBS=2
# Seconds before a single conversion is stopped
# JOB_TIMEOUT_S=180
# Largest converted file the server will send back (MB)
# MAX_OUTPUT_MB=500
# Largest total size an archive may unpack to (MB) - zip-bomb protection
# MAX_EXTRACT_MB=500
# Switch engines off even if installed, by binary name (e.g. heavy video work)
# SQUISH_DISABLE=ffmpeg,ebook-convert

# "How was your experience?" popup: the page where visitors review the site, e.g. Trustpilot
# https://www.trustpilot.com/evaluate/yourdomain.com (or a Google review link in
# GOOGLE_REVIEW_URL). The button names the site. Without it the popup still collects ratings
# and comments for the dashboard.
# REVIEW_URL=

# Trustpilot TrustBox in the footer: live stars and review count, updated by Trustpilot. Copy the
# two IDs from the widget code (Trustpilot dashboard > Integrations > TrustBox):
# data-businessunit-id and data-template-id, and the height from data-style-height.
# TRUSTPILOT_BUSINESS_ID=
# TRUSTPILOT_TEMPLATE_ID=
# TRUSTPILOT_HEIGHT=24px

# --- PDF intelligence: AI Summarizer + chat, Translate PDF, PDF to Markdown ---
# Off until PDF_AI=1 (the pages, menu links and API routes do not exist without it)
# PDF_AI=1
# API key from https://platform.claude.com (Settings > API keys). Without it the AI tools say
# they are not switched on yet; PDF to Markdown works without it. Keep the key only in this file.
# ANTHROPIC_API_KEY=
# Claude model (claude-haiku-5-5 costs about 40x less than the default, with simpler answers)
# AI_MODEL=claude-opus-5-5
# AI requests one connection may make per hour, and for the whole site per day (spending caps)
# AI_PER_HOUR=40
# AI_DAILY_MAX=2000
# Largest PDFs: pages for the summarizer, pages for Translate PDF, characters of text sent to Claude
# AI_MAX_PAGES=100
# AI_TRANSLATE_MAX_PAGES=30
# AI_MAX_CHARS=250000

# Google AdSense (leave empty until your account is approved). See README "AdSense".
# ADSENSE_CLIENT=ca-pub-0000000000000000
# Optional ad unit IDs; without them, use Auto ads in the AdSense dashboard.
# ADSENSE_SLOT_TOP=
# ADSENSE_SLOT_BOTTOM=
# ADSENSE_SLOT_LEFT=
# ADSENSE_SLOT_RIGHT=
