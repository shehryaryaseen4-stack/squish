{
  "name": "flipfree",
  "version": "1.0.0",
  "description": "Free online file converter: images, video, audio, documents, ebooks, archives and fonts, using open-source engines (Sharp, FFmpeg, LibreOffice, Pandoc, Calibre, Ghostscript, Inkscape).",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:conversions": "CONVERSIONS=full node --test --test-concurrency=1 test/conversions.test.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "compression": "^1.7.4",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jimp": "^1.6.1",
    "jszip": "^3.10.1",
    "multer": "^2.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.35.4",
    "wawoff2": "^2.0.1"
  }
}
