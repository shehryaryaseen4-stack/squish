{
  "name": "gym-app-desktop",
  "productName": "GymDesk",
  "version": "1.0.0",
  "description": "Gym management for Windows: online account, offline licence or demo, with the entry screen on a second monitor.",
  "main": "main.js",
  "private": true,
  "author": "GymDesk",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.gymdesk.desktop",
    "productName": "GymDesk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "setup.css",
      "setup.js",
      "config.json",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server.js",
        "to": "server/server.js"
      },
      {
        "from": "../lib",
        "to": "server/lib"
      },
      {
        "from": "../seed",
        "to": "server/seed"
      },
      {
        "from": "../public",
        "to": "server/public"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "gym-app-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "GymDesk"
    }
  }
}
