{
  "name": "gym-app",
  "version": "1.0.0",
  "description": "Gym management app: members, fees, attendance, classes, expenses and reports, with Android and iOS member apps.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "mobile:build": "node scripts/build-mobile.js && cap sync",
    "mobile:android": "node scripts/build-mobile.js && cap sync android && cap open android",
    "mobile:ios": "node scripts/build-mobile.js && cap sync ios && cap open ios",
    "mobile:icons": "npx @capacitor/assets@3 generate --android --ios --iconBackgroundColor '#f97316' --iconBackgroundColorDark '#3b1a06' --splashBackgroundColor '#f97316' --splashBackgroundColorDark '#0c0c11'",
    "demo:build": "node scripts/build-demo.js"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3"
  }
}
